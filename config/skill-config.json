{
  "version": "4.3.1",
  "name": "teacher-skills",
  "description": "AI老师Skill - HTML 主课堂：分步课件、答题卡提交、自适应补讲/练习/复习",
  "author": "teacher-skills",
  "license": "MIT",
  "skill": {
    "entry": "SKILL.md",
    "type": "teaching",
    "supported_formats": [
      "pdf",
      "txt",
      "md",
      "html",
      "docx",
      "epub"
    ],
    "max_context_units": 50,
    "default_check_interval": 1
  },
  "learner_levels": {
    "beginner": {
      "label": "初学者",
      "icon": "🔴",
      "teaching_ratio": "70%讲解 / 30%练习",
      "check_frequency": "每步检查",
      "question_types": [
        "选择题",
        "判断题",
        "填空题"
      ]
    },
    "intermediate": {
      "label": "中等基础",
      "icon": "🟡",
      "teaching_ratio": "50%讲解 / 50%练习",
      "check_frequency": "每概念检查",
      "question_types": [
        "复述题",
        "应用题",
        "改错题"
      ]
    },
    "advanced": {
      "label": "强基础",
      "icon": "🟢",
      "teaching_ratio": "30%讲解 / 70%练习",
      "check_frequency": "每2-3概念检查",
      "question_types": [
        "分析题",
        "综合题",
        "设计题"
      ]
    }
  },
  "teaching_phases": [
    {
      "phase": 0,
      "name": "接收资料",
      "required": true
    },
    {
      "phase": 1,
      "name": "学情诊断",
      "required": true,
      "sub_steps": [
        "基本信息收集",
        "能力快速评估",
        "告知判断结果"
      ]
    },
    {
      "phase": 2,
      "name": "制定学习路线",
      "required": true,
      "sub_steps": [
        "确定教学顺序",
        "拆分学习单元",
        "设定检查点"
      ]
    },
    {
      "phase": 3,
      "name": "逐单元教学",
      "required": true,
      "sub_steps": [
        "单元导入",
        "概念讲解",
        "理解检查",
        "巩固与过渡"
      ]
    },
    {
      "phase": 4,
      "name": "阶段性回顾",
      "interval": "每3-5个单元"
    },
    {
      "phase": 5,
      "name": "学习完成总结",
      "required": true
    }
  ],
  "scripts": {
    "generate_quiz": {
      "path": "scripts/generate_quiz.py",
      "description": "根据概念和等级生成练习题模板",
      "usage": "python scripts/generate_quiz.py --concept <概念> --level <等级> --type <题型>"
    },
    "evaluate_answer": {
      "path": "scripts/evaluate_answer.py",
      "description": "评估用户答案并生成反馈模板",
      "usage": "python scripts/evaluate_answer.py --answer <答案> --expected <期望> --level <等级>"
    },
    "track_progress": {
      "path": "scripts/track_progress.py",
      "description": "追踪学习进度",
      "usage": "python scripts/track_progress.py --init --topic <主题> --total-units <数量>"
    },
    "lesson_html": {
      "path": "scripts/lesson_html.py",
      "description": "Markdown 讲义/练习 → 自包含 HTML + 课程 index",
      "usage": "python scripts/lesson_html.py build|rebuild|index --course <课程> [--file <md>] [--state <state.json>]"
    },
    "mastery": {
      "path": "scripts/mastery.py",
      "description": "自适应掌握度：记录练习结果、复习计划、下一步建议",
      "usage": "python scripts/mastery.py record|advise|due|practice|show --state <state.json>"
    },
    "course_server": {
      "path": "scripts/course_server.py",
      "description": "本地课件服务 + 答题卡提交（写入 answers/latest.json）",
      "usage": "python scripts/course_server.py --course <课程> --port 8765"
    },
    "dsh_host": {
      "path": "scripts/dsh_host.py",
      "description": "探测 DSH 插件、课程服务或空闲端口",
      "usage": "python scripts/dsh_host.py --course <课程> --workspace <工作区名> --json"
    }
  },
  "references": [
    {
      "path": "ref/learner-diagnosis.md",
      "description": "学情诊断指南"
    },
    {
      "path": "ref/teaching-strategies.md",
      "description": "三级教学策略详细定义"
    },
    {
      "path": "ref/teaching-techniques.md",
      "description": "通俗化讲解技巧和类比库"
    },
    {
      "path": "ref/question-templates.md",
      "description": "各类型题目出题模板"
    },
    {
      "path": "ref/adaptive-teaching.md",
      "description": "自适应教学引擎：掌握度、决策规则、练习与复习"
    },
    {
      "path": "ref/html-lessons.md",
      "description": "HTML 讲义/练习格式、生成命令、index 与排错"
    },
    {
      "path": "ref/subject-plugins.md",
      "description": "学科插件协议：knowledge / methodology 分流"
    },
    {
      "path": "ref/html-first-teaching.md",
      "description": "HTML-first 教学法：课堂/聊天分工、课件生成、批改与补讲"
    },
    {
      "path": "ref/dsh-hosting.md",
      "description": "DSH 宿主选择：插件/独立服务/静态导出"
    }
  ],
  "html_output": {
    "enabled": true,
    "dir": "讲义",
    "auto_after_unit": true,
    "answers_collapsed": true,
    "theme": "auto",
    "build_command": "python scripts/lesson_html.py build --course {course} --file {file} --state {state}",
    "rebuild_command": "python scripts/lesson_html.py rebuild --course {course} --state {state}",
    "index_command": "python scripts/lesson_html.py index --course {course} --state {state}",
    "layout": "deck",
    "answers_dir": "answers",
    "server": {
      "script": "scripts/course_server.py",
      "host": "127.0.0.1",
      "port": 8765,
      "answers_file": "answers/latest.json"
    },
    "api_path": "/teacher/api/answers",
    "workspace": "auto"
  },
  "adaptive": {
    "enabled": true,
    "advance_requires": [
      "first_pass",
      "variant_pass"
    ],
    "mastery_levels": [
      "未掌握",
      "模糊",
      "基本掌握",
      "掌握"
    ],
    "review_intervals_days": [
      1,
      3,
      7,
      14,
      30
    ],
    "review_batch_limit": 3,
    "review_backlog_threshold": 5,
    "practice_default_count": 3,
    "max_rounds_per_concept": 3,
    "autonomy": {
      "within_unit": "auto",
      "advance_unit": "auto_after_gate",
      "change_route": "confirm",
      "skip_verification": "confirm"
    },
    "error_tags": [
      "概念混淆",
      "步骤遗漏",
      "计算错误",
      "读题不完整",
      "表达不清",
      "迁移失败",
      "记忆混淆"
    ],
    "answer_source": "讲义/{course}/answers/latest.json",
    "page_types": {
      "reteach": "reteach-XX-标题.html",
      "practice": "practice-XX-标题.html",
      "review": "review-XX-标题.html",
      "advance": "unit-XX-标题.html"
    }
  },
  "subjects": {
    "types": [
      "knowledge",
      "methodology"
    ],
    "micro_flow": "每个 subjects/*.md 的 frontmatter 含 subject/type/version，正文含 5 步执行微流程",
    "template": "subjects/_template-SKILL.md",
    "html_first": "v4.0：HTML 主课堂；聊天只做诊断/答疑/批改/决策"
  },
  "dsh_host": {
    "probe_script": "scripts/dsh_host.py",
    "plugin_repo": "git@github.com:BTHawake/dsh-Teacher-skill.git",
    "plugin_id": "teacher-course",
    "health_path": "/teacher/api/health",
    "answers_path": "/teacher/api/answers",
    "restart_required": true
  }
}
